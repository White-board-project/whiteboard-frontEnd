{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!.next",
            "!out",
            "!coverage",
            "!playwright-report",
            "!test-results",
            "!pnpm-lock.yaml"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
